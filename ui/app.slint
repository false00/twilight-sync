import { ScrollView, LineEdit, ProgressIndicator, Palette } from "std-widgets.slint";
import { Theme, ActionButton, SectionTitle, Muted, Surface, SwitchRow, GameTile, NavigationItem, PageHeading, StatusBadge, DetailBlock, SaveProgress } from "components.slint";

export enum Action {
    select-oot-project,
    play, sync-save, setup, locate-game, refresh, compare, continue-local,
    use-local, use-remote, accept-save, decline-save, recover, approve-recovery, decline-recovery,
    check-source, reset-source, review-source, compare-source, tool-help, nvidia-terms, prepare-tools, build-source, cancel-source, use-built, open-log,
    setup-dotnet, setup-msys, setup-visual-studio, copy-dotnet, copy-msys, copy-visual-studio, check-release, install-release,
    trust-network, open-pairing, connect-device, reconnect, approve-pairing, reject-pairing, unpair, view-game,
    history-refresh, history-older, history-preview, history-restore, close-preview,
    check-app-update, update-app, choose-iso, send-iso, accept-iso, decline-iso, offer-game-file,
    open-texture-site, import-texture-zip, import-texture-folder, import-existing-textures, cancel-textures, activate-texture,
    disable-textures, recover-textures, refresh-textures, open-data, open-licenses,
    app-release-notes, official-help, project-link, preview-scenario, export-preview, create-desktop-shortcut, quit
}
export enum Toggle { source-mode, source-consent, managed-tools, renodx, fsr, nvidia, shaders, startup, updates, disc-sharing, texture-consent, game-file-sharing, key-sharing }
export enum AppearanceMode { system, light, dark }
export struct GameCard { title: string, subtitle: string, status: string, installed: bool }
export struct SaveCard { title: string, kind: string, date: string, hearts: string, rupees: string, played: string, extra: string, warning: string }
export struct DeviceCard { name: string, detail: string, pairing: bool }
export struct AttentionCard { game-index: int, title: string, detail: string }
export struct HistoryCard { id: string, title: string, detail: string, metadata: string, ancestry: string, branch: int, current: bool }
export struct ToolRow { name: string, detail: string, ready: bool, busy: bool, setup: int }
export struct PackCard { title: string, detail: string, metadata: string, active: bool }
export struct TextureCreator { name: string, description: string, version: string, has-site: bool }

component CompactActionButton inherits ActionButton {
    min-width: 64px;
    max-width: self.preferred-width;
    horizontal-stretch: 0;
    min-height: 44px;
    preferred-height: 44px;
    max-height: 44px;
}

component BuildPrerequisite inherits VerticalLayout {
    in property <ToolRow> tool;
    in property <bool> available;
    property <bool> expanded: false;
    callback setup(int);
    callback commands(int);
    callback help;
    spacing: 8px;
    HorizontalLayout {
        spacing: 10px;
        Text {
            text: root.tool.busy ? "INSTALLING" : root.tool.ready ? "FOUND" : "SETUP NEEDED";
            color: root.tool.busy ? Theme.accent : root.tool.ready ? Theme.success : Theme.warning;
            font-size: 11px; width: 110px; vertical-alignment: center;
        }
        Muted { text: root.tool.name; horizontal-stretch: 1; min-width: 0px; }
    }
    HorizontalLayout {
        spacing: 8px; alignment: start;
        if root.tool.setup > 0: ActionButton {
            text: root.tool.ready ? "Installed" : "Set up";
            width: 112px; available: root.available && !root.tool.ready;
            clicked => { root.setup(root.tool.setup); }
        }
        if root.tool.setup > 0: ActionButton {
            text: "Commands"; subtle: true; available: root.available;
            clicked => { root.commands(root.tool.setup); }
        }
        if root.tool.setup == 0: ActionButton {
            text: "Instructions"; available: root.available && !root.tool.ready;
            clicked => { root.help(); }
        }
        ActionButton {
            text: root.expanded ? "Hide details" : "Details"; subtle: true;
            available: root.expanded || root.tool.detail != "";
            clicked => { root.expanded = !root.expanded; }
        }
    }
    if root.expanded && root.tool.detail != "": Text {
        text: root.tool.detail; color: Theme.warning; font-size: 14px;
        wrap: char-wrap; min-width: 0px;
    }
}

component GameFileInput inherits Surface {
    in property <string> title;
    in property <string> description;
    in property <string> selected-path;
    in property <string> empty-text: "No file selected";
    in property <string> choose-label;
    in property <string> clear-label: "Clear selection";
    in property <bool> available: true;
    callback choose;
    callback clear;
    VerticalLayout {
        padding: 20px; spacing: 12px;
        SectionTitle { text: root.title; }
        Muted { text: root.description; }
        if root.selected-path == "": Muted { text: root.empty-text; }
        if root.selected-path != "": DetailBlock { title: "SELECTED INPUT"; text: root.selected-path; }
        HorizontalLayout {
            spacing: 8px;
            ActionButton { text: root.choose-label; available: root.available; clicked => { root.choose(); } }
            if root.selected-path != "": ActionButton { text: root.clear-label; available: root.available; clicked => { root.clear(); } }
        }
    }
}

component GameInputTransfers inherits VerticalLayout {
    in property <int> game;
    in property <bool> sharing;
    in property <bool> key-sharing;
    in property <bool> can-choose;
    in property <bool> can-offer;
    in property <bool> can-offer-update;
    in property <bool> can-offer-keys;
    in property <string> reason;
    in property <string> input;
    in property <string> update;
    in property <string> keys;
    callback offer(int);
    callback choose(int);
    callback sharing-toggled(bool);
    callback keys-toggled(bool);
    spacing: 12px;
    Muted { text: "Send selected game inputs over encrypted twilightProto on your approved LAN. Enable the same permission on both PCs. The receiver chooses a new destination; nothing is overwritten or installed automatically."; }
    SwitchRow { title: "I own this game and allow game-file transfers"; checked: root.sharing; toggled(value) => { root.sharing-toggled(value); } }
    if root.reason != "": Muted { text: root.reason; color: Theme.warning; }
    DetailBlock { title: root.game == 2 ? "OOT GAME INPUT" : "TOTK BASE GAME"; text: root.input == "" ? "No game file selected" : root.input; }
    HorizontalLayout {
        spacing: 10px;
        ActionButton { text: "Choose game file"; available: root.can-choose; clicked => { root.choose(0); } }
        ActionButton { text: root.game == 2 ? "Offer OOT .nup" : "Offer TotK base .nsp"; available: root.can-offer; clicked => { root.offer(0); } }
    }
    Muted { text: root.game == 2 ? "Only OOT .nup files can be transferred, not extracted folders." : "Only base/update .nsp files can be transferred. XCI, NSZ and XCZ inputs remain local-only."; }
    if root.game == 1: VerticalLayout {
        spacing: 12px;
        DetailBlock { title: "TOTK UPDATE"; text: root.update == "" ? "No update selected" : root.update; }
        HorizontalLayout {
            spacing: 10px;
            ActionButton { text: "Choose update file"; available: root.can-choose; clicked => { root.choose(1); } }
            ActionButton { text: "Offer TotK update .nsp"; available: root.can-offer-update; clicked => { root.offer(1); } }
        }
        SwitchRow { title: "Also allow my console keys to this paired PC"; description: "Sensitive: enable this separately on both PCs before offering prod.keys. The receiver must also approve each file."; checked: root.key-sharing; toggled(value) => { root.keys-toggled(value); } }
        DetailBlock { title: "CONSOLE KEY FILE"; text: root.keys == "" ? "No prod.keys file selected. Choose your existing key file." : root.keys; }
        HorizontalLayout {
            spacing: 10px;
            ActionButton { text: "Choose key file"; available: root.can-choose; clicked => { root.choose(2); } }
            ActionButton { text: "Offer prod.keys"; available: root.can-offer-keys; clicked => { root.offer(2); } }
        }
    }
    Muted { text: "These selections are shared with Game setup and reused for builds. Sending is manual; no files are copied automatically."; }
    Muted { text: "Container checks and SHA-256 detect transfer damage, not game ownership, title identity or authenticity. Received files become local setup inputs; review them before building."; }
}

component BranchPreview inherits Rectangle {
    in property <string> title;
    in property <string> revision;
    in property <string> changes;
    in property <[SaveCard]> saves;
    in property <bool> selectable;
    in property <bool> selected;
    in property <bool> remote;
    callback choose;
    border-radius: 18px;
    background: root.selected ? Theme.selection : Theme.raised;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : Theme.line;
    VerticalLayout {
        padding: 14px; spacing: 12px; alignment: start;
        SectionTitle { text: root.title; }
        ActionButton {
            text: root.remote ? "Select other PC's branch" : "Select this PC's branch";
            available: root.selectable; primary: root.selected; modal-control: true;
            clicked => { root.choose(); }
        }
        DetailBlock { title: "SNAPSHOT · SHA-256"; text: root.revision == "" ? "Waiting for a verified snapshot" : root.revision; }
        if root.changes != "": Muted { text: root.changes; }
        if root.saves.length == 0: Muted { text: "Waiting for verified progress details. A branch cannot be chosen until both complete snapshots are verified."; }
        for save in root.saves: SaveProgress {
            title: save.title; kind: save.kind; date: save.date;
            hearts: save.hearts; rupees: save.rupees; played: save.played;
            extra: save.extra; warning: save.warning; modal-control: true;
        }
    }
}

export component MainWindow inherits Window {
    in property <string> window-title: "Twilight Sync";
    title: root.window-title;
    preferred-width: 1200px; preferred-height: 820px;
    min-width: 720px; min-height: 600px;
    default-font-family: "Segoe UI";
    default-font-size: 15px;
    background: Theme.canvas;
    icon: @image-url("../assets/app-icon-256.png");
    in-out property <int> section: 0;
    property <[length]> page-scroll: [0px, 0px, 0px, 0px, 0px, 0px];
    out property <length> scroll-position: main-scroll.content-y;
    in-out property <int> selected-game: 0;
    in-out property <bool> dark-mode: true;
    in property <AppearanceMode> appearance-mode: AppearanceMode.system;
    in property <bool> demo-mode;
    in property <string> version;
    in property <string> build-target;
    in property <string> build-profile;
    in property <string> status;
    in property <string> connection;
    in property <bool> connected;
    in property <string> error;
    in property <[GameCard]> games;
    in property <[SaveCard]> local-saves;
    in property <[SaveCard]> remote-saves;
    in property <[DeviceCard]> devices;
    in property <[AttentionCard]> attention;
    in property <[HistoryCard]> history;
    in property <[ToolRow]> tools;
    in property <bool> tools-missing;
    in-out property <bool> show-tool-details: true;
    in property <[PackCard]> packs;
    in property <string> game-title;
    in property <string> game-subtitle;
    in property <string> installed-path;
    in property <string> installed-executable;
    in property <string> installed-release;
    in property <bool> installed;
    in property <bool> can-play;
    in property <bool> can-sync;
    in property <bool> can-continue;
    in property <bool> can-restore;
    in property <bool> can-resolve;
    in property <bool> can-accept-save;
    in property <bool> can-recover;
    in property <bool> can-manage;
    in property <bool> can-install;
    in property <bool> can-locate;
    in property <bool> has-conflict;
    in property <bool> pending-save;
    in property <bool> recovery-needed;
    in property <bool> incoming-recovery;
    in property <string> play-reason;
    in property <string> sync-reason;
    in property <string> save-state;
    in property <string> game-status;
    in property <string> game-message;
    in property <string> verified-at;
    in property <bool> saves-match;
    in property <string> local-revision;
    in property <string> remote-revision;
    in property <string> base-revision;
    in property <string> local-changes;
    in property <string> remote-changes;
    in property <string> comparison-reason;
    in property <string> connection-setup;
    in property <string> transfer;
    in property <bool> management-available;
    in-out property <bool> show-other-saves: false;
    in-out property <bool> show-verification: false;
    in-out property <bool> comparison-open: false;
    in-out property <int> branch-choice: -1;
    in property <bool> source-mode;
    in property <bool> longshot;
    in property <bool> source-busy;
    in property <bool> source-building;
    in property <bool> build-complete;
    in property <bool> build-needs-activation;
    in property <int> build-result-game;
    in property <string> build-result-title;
    in-out property <bool> build-result-dismissed: false;
    in property <bool> operation-busy;
    in property <bool> desktop-shortcut-busy;
    in property <bool> preferences-valid: true;
    in property <bool> has-built;
    in property <bool> sdk-busy;
    in property <bool> source-ready;
    in property <string> source-activation-blocker;
    in property <bool> source-consent;
    in property <bool> managed-tools;
    in property <bool> renodx;
    in property <bool> fsr;
    in property <bool> nvidia;
    in property <bool> shaders;
    in property <string> source-tag;
    in property <string> source-commit;
    in property <string> source-comparison;
    in property <string> release-comparison;
    in property <bool> can-compare-source;
    in property <string> source-message;
    in property <string> source-error;
    in property <string> source-log;
    in property <bool> source-progress-visible;
    in property <bool> source-progress-known;
    in property <float> source-progress;
    in property <string> source-elapsed;
    in property <string> source-work;
    in property <string> source-eta;
    in property <string> source-rate;
    in property <string> source-activity;
    in property <string> source-activity-status;
    in-out property <bool> show-source-activity: false;
    in property <string> source-blocker;
    in property <string> source-input;
    in property <string> source-update;
    in property <string> source-keys;
    in property <string> source-firmware;
    in property <string> release-tag;
    in property <string> release-detail;
    in property <string> install-reason;
    in property <string> network-name;
    in property <string> network-detail;
    in property <bool> network-trusted;
    in property <bool> network-available;
    in property <string> network-fingerprint;
    in-out property <bool> show-network-details: false;
    in property <bool> can-pair;
    in property <bool> can-reconnect;
    in property <bool> connecting;
    in property <bool> pairing-open;
    in property <string> pairing-code;
    in property <bool> pairing-approved;
    in property <bool> remote-approved;
    in property <string> peer-name;
    in property <string> peer-key;
    in property <string> public-key;
    in-out property <bool> show-peer-identity: false;
    in property <bool> startup;
    in property <bool> auto-updates;
    in property <string> app-update;
    in property <bool> can-update-app;
    in property <bool> can-check-app;
    in property <bool> has-app-release;
    in property <string> app-release-detail;
    in property <string> app-update-reason;
    in property <bool> disc-sharing;
    in property <bool> game-file-sharing;
    in property <bool> key-sharing;
    in property <bool> can-offer-game-file;
    in property <bool> can-offer-update;
    in property <bool> can-offer-keys;
    in property <string> game-file-transfer-reason;
    in property <string> iso-path;
    in property <bool> pending-iso;
    in property <bool> can-send-iso;
    in property <string> disc-offer;
    in property <bool> can-accept-iso;
    in property <bool> history-more;
    in property <string> history-info;
    in property <string> history-storage;
    in property <float> history-usage;
    in-out property <bool> show-history-storage: false;
    in property <string> preview-title;
    in property <string> preview-id;
    in property <[SaveCard]> preview-saves;
    in property <string> texture-status;
    in property <string> texture-reason;
    in property <[TextureCreator]> texture-creators;
    in-out property <int> texture-creator: 0;
    in-out property <string> texture-version: "1.2.0";
    in property <bool> texture-consent;
    in property <bool> texture-busy;
    in property <bool> texture-cancellable;
    in property <bool> texture-recovery;
    in property <bool> can-import-textures;
    in property <bool> can-change-textures;
    in property <bool> textures-active;
    in property <bool> textures-unmanaged;
    in property <string> texture-profile;
    in-out property <bool> texture-picker-open: false;
    in-out property <bool> texture-details-open: false;
    in-out property <bool> texture-profile-open: false;
    in-out property <bool> about-open: false;
    in-out property <bool> confirmation-open: false;
    in property <string> confirmation-title;
    in property <string> confirmation-message;
    callback confirmation-response(bool);
    in-out property <int> setup-step: 0;
    in-out property <bool> advanced-source: false;
    in-out property <bool> extra-game-inputs: false;
    callback action(Action, int);
    callback game-selected(int);
    callback toggle(Toggle, bool);
    callback choose-input(int);
    callback clear-input(int);
    callback appearance-selected(AppearanceMode);
    init => {
        Theme.dark = root.dark-mode;
        Theme.modal-open = false;
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-mode => {
        Theme.dark = root.dark-mode;
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    public function navigate(next: int) {
        if next != root.section && next >= 0 && next < 6 {
            root.page-scroll[root.section] = main-scroll.content-y;
            root.section = next;
        }
    }
    changed section => { main-scroll.content-y = root.page-scroll[root.section]; }
    changed build-complete => { root.build-result-dismissed = false; }
    changed build-needs-activation => { root.build-result-dismissed = false; }
    changed selected-game => {
        if root.section != 5 { main-scroll.content-y = 0px; }
        root.setup-step = 0;
        root.extra-game-inputs = false;
        root.show-other-saves = false; root.comparison-open = false;
    }
    changed comparison-open => { root.branch-choice = -1; root.update-modal-state(); }
    changed about-open => { root.update-modal-state(); }
    changed confirmation-open => { root.update-modal-state(); }
    function update-modal-state() {
        Theme.modal-open = root.comparison-open || root.about-open || root.confirmation-open;
    }
    changed has-conflict => { root.branch-choice = -1; if !root.has-conflict { root.comparison-open = false; } }
    changed local-revision => { root.branch-choice = -1; }
    changed remote-revision => { root.branch-choice = -1; }
    changed texture-creator => {
        root.texture-version = root.texture-creators[root.texture-creator].version;
        root.toggle(Toggle.texture-consent, false);
    }

    Rectangle {
        width: root.width; height: root.height;
        background: Theme.dark ? @linear-gradient(135deg, #242936 0%, #17171b 48%, #24212b 100%) : @linear-gradient(135deg, #e6edf9 0%, #f5f5f7 48%, #f1eaf4 100%);
    }
    VerticalLayout {
        x: 0px; y: 0px;
        width: root.width; height: root.height;
        spacing: 0px;
        Rectangle {
            height: 76px;
            background: Theme.chrome;
            HorizontalLayout {
                padding-left: 24px; padding-right: 24px; padding-top: 14px; padding-bottom: 14px; spacing: 12px;
                Image { source: @image-url("../assets/app-icon-256.png"); width: 38px; height: 38px; }
                VerticalLayout {
                    alignment: center; spacing: 2px;
                    Text { text: "Twilight Sync"; font-weight: 700; font-size: 20px; color: Theme.text; }
                    Muted { text: root.demo-mode ? "PREVIEW · EXAMPLE DATA" : "YOUR LIBRARY, IN SYNC"; font-size: 9px; }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                StatusBadge { text: root.connection; tint: root.connected ? Theme.success : root.connecting || root.pairing-code != "" ? Theme.accent : Theme.muted; }
                ActionButton { text: "About"; min-width: 64px; max-width: 80px; horizontal-stretch: 0; subtle: true; clicked => { root.about-open = true; } }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }
        if root.build-complete && !root.build-result-dismissed: Rectangle {
            height: 56px;
            background: root.build-needs-activation ? Theme.warning-fill : Theme.dark ? #74d99a14 : #e9f7ee;
            Rectangle { width: 3px; background: root.build-needs-activation ? Theme.warning : Theme.success; }
            Rectangle { height: 1px; y: parent.height - self.height; background: Theme.line; }
            build-notice := HorizontalLayout {
                padding-left: 20px; padding-right: 20px; padding-top: 6px; padding-bottom: 6px; spacing: 10px;
                VerticalLayout {
                    horizontal-stretch: 1; min-width: 0px; alignment: center; spacing: 1px;
                    Text {
                        text: root.build-needs-activation ? "Build ready — activation required" : "Build complete";
                        color: root.build-needs-activation ? Theme.warning : Theme.success;
                        font-size: 14px; font-weight: 700; overflow: elide; min-width: 0px;
                    }
                    Muted { text: root.build-result-title; font-size: 12px; wrap: no-wrap; overflow: elide; min-width: 0px; }
                }
                CompactActionButton {
                    text: !root.build-needs-activation && root.section == 1 && root.selected-game == root.build-result-game ? "Go to Play" : "View build";
                    clicked => {
                        root.navigate(!root.build-needs-activation && root.section == 1 && root.selected-game == root.build-result-game ? 0 : 1);
                        root.selected-game = root.build-result-game;
                        root.game-selected(root.build-result-game);
                    }
                }
                CompactActionButton { text: "Dismiss"; subtle: true; clicked => { root.build-result-dismissed = true; } }
            }
        }
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: root.width < 1000px ? 156px : 196px; background: Theme.chrome;
                VerticalLayout {
                    padding: 12px; padding-top: 22px; spacing: 6px;
                    Text { text: "WORKSPACE"; color: Theme.muted; font-size: 9px; letter-spacing: 1px; min-height: 24px; }
                    for label[index] in ["Play", "Game setup", "Devices", "Save history", "Textures", "Settings"]: NavigationItem {
                        text: label; icon: index; selected: root.section == index;
                        clicked => { root.navigate(index); }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Rectangle { height: 1px; background: Theme.line; }
                    Muted { text: "On your PCs.\nUnder your control."; font-size: 11px; }
                    Muted { text: "v" + root.version; font-size: 11px; }
                }
            }
            Rectangle { width: 1px; background: Theme.line; }
            main-scroll := ScrollView {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: root.width < 900px ? 20px : 30px; spacing: 18px; alignment: start;
                    if root.error != "": Rectangle {
                        border-radius: 14px; background: Theme.danger-fill; border-width: 1px; border-color: Theme.line;
                        HorizontalLayout { padding: 16px; Text { text: root.error; color: Theme.danger; wrap: word-wrap; } }
                    }
                    for item in root.attention: Surface {
                        HorizontalLayout {
                            padding: 16px; spacing: 12px;
                            VerticalLayout {
                                spacing: 4px; horizontal-stretch: 1;
                                Text { text: item.title; color: Theme.warning; font-weight: 600; wrap: word-wrap; }
                                Muted { text: item.detail; }
                            }
                            ActionButton { text: "Review decision"; clicked => { root.action(Action.view-game, item.game-index); } }
                        }
                    }
                    if root.pending-iso: Surface {
                        VerticalLayout {
                            padding: 16px; spacing: 12px;
                            SectionTitle { text: "Your paired PC offers a file"; }
                            Muted { text: root.disc-offer; color: Theme.warning; }
                            HorizontalLayout {
                                spacing: 10px;
                                ActionButton { text: "Choose destination & receive"; available: root.can-accept-iso; clicked => { root.action(Action.accept-iso, 0); } }
                                ActionButton { text: "Decline file"; clicked => { root.action(Action.decline-iso, 0); } }
                            }
                        }
                    }
                    if root.transfer != "": Surface {
                        VerticalLayout {
                            padding: 16px; spacing: 8px;
                            Text { text: "Encrypted transfer"; color: Theme.accent; font-weight: 600; }
                            Muted { text: root.transfer; }
                            ProgressIndicator { indeterminate: true; }
                        }
                    }
                    if root.section == 1 || root.section == 3: HorizontalLayout {
                        spacing: 12px;
                        for game[index] in root.games: ActionButton {
                            text: game.title; primary: root.selected-game == index;
                            clicked => { root.selected-game = index; root.game-selected(index); }
                        }
                    }
                    if root.section == 0: VerticalLayout {
                        spacing: 18px;
                        PageHeading { title: "Your library"; description: "Three worlds. One place to pick up where you left off."; }
                        if root.pending-save: Surface {
                            VerticalLayout {
                                padding: 20px; spacing: 12px;
                                SectionTitle { text: root.has-conflict ? "Different progress needs your decision" : "A save is waiting for your decision"; }
                                Muted { text: root.game-title + " · Compare before choosing. Your existing progress is retained before replacement."; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    ActionButton { text: "Accept save"; primary: !root.has-conflict; available: root.can-accept-save; clicked => { root.action(Action.accept-save, 0); } }
                                    ActionButton { text: "Keep this PC"; clicked => { root.action(Action.decline-save, 0); } }
                                    if root.has-conflict: ActionButton { text: "Compare saves"; primary: true; clicked => { root.comparison-open = true; root.action(Action.compare, 0); } }
                                }
                                ActionButton { text: "Keep both, play here"; available: root.can-continue; clicked => { root.action(Action.continue-local, 0); } }
                            }
                        }
                        if root.has-conflict && !root.pending-save: Surface {
                            VerticalLayout {
                                padding: 20px; spacing: 12px;
                                SectionTitle { text: "Two adventures. You choose."; }
                                Muted { text: root.game-title + " · Both PCs have different progress. We never silently pick a winner."; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton { text: "Compare saves"; primary: true; clicked => { root.comparison-open = true; root.action(Action.compare, 0); } }
                                    ActionButton { text: "Keep both, play here"; available: root.can-continue; clicked => { root.action(Action.continue-local, 0); } }
                                }
                            }
                        }
                        if root.recovery-needed: Surface {
                            VerticalLayout {
                                padding: 20px; spacing: 12px;
                                SectionTitle { text: "Finish the previous play session"; }
                                Muted { text: root.game-title + " · Reservations protect your saves, even after a restart. Recover only after play has ended."; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    if !root.incoming-recovery: ActionButton { text: "Recover session"; available: root.can-recover; clicked => { root.action(Action.recover, 0); } }
                                    if root.incoming-recovery: ActionButton { text: "Approve recovery"; available: root.can-recover; clicked => { root.action(Action.approve-recovery, 0); } }
                                    if root.incoming-recovery: ActionButton { text: "Keep reservation"; clicked => { root.action(Action.decline-recovery, 0); } }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 14px;
                            for game[index] in root.games: GameTile {
                                horizontal-stretch: 1;
                                title: game.title; status: game.status; selected: root.selected-game == index;
                                artwork: index == 0 ? @image-url("../assets/adventure-twilight.svg") : index == 1 ? @image-url("../assets/adventure-sky.svg") : @image-url("../assets/adventure-time.svg");
                                clicked => { root.selected-game = index; root.game-selected(index); }
                            }
                        }
                        Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 14px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout { spacing: 4px; horizontal-stretch: 1; SectionTitle { text: root.game-title; } Muted { text: root.game-subtitle; font-size: 12px; } }
                                    StatusBadge { text: root.game-status; tint: root.saves-match ? Theme.success : root.has-conflict || root.recovery-needed || root.pending-save ? Theme.warning : Theme.accent; }
                                }
                                if root.selected-game == 2: HorizontalLayout {
                                    spacing: 10px;
                                    ActionButton { text: "Triforce"; primary: !root.longshot; available: root.can-manage; clicked => { root.action(Action.select-oot-project, 0); } }
                                    ActionButton { text: "Longshot"; primary: root.longshot; available: root.can-manage; clicked => { root.action(Action.select-oot-project, 1); } }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    ActionButton { text: root.installed ? "Play" : "Set up game"; primary: true; available: root.installed ? root.can-play : root.can-manage; clicked => { if root.installed { root.action(Action.play, 0); } else { root.navigate(1); } } }
                                    ActionButton { text: "Sync progress"; available: root.can-sync; clicked => { root.action(Action.sync-save, 0); } }
                                    ActionButton { text: "History"; subtle: true; clicked => { root.navigate(3); root.action(Action.history-refresh, 0); } }
                                    ActionButton { text: "Refresh"; subtle: true; min-width: 76px; clicked => { root.action(Action.refresh, 0); } }
                                }
                                if root.game-message != "" && !root.saves-match && root.game-message != root.play-reason: Muted { text: root.game-message; }
                                if root.play-reason != "": Muted { text: root.play-reason; }
                                if root.sync-reason != "" && root.sync-reason != root.play-reason: Muted { text: root.sync-reason; }
                                if root.verified-at != "": Muted { text: "Last verified: " + root.verified-at; font-size: 12px; }
                                if root.connection-setup != "": HorizontalLayout {
                                    spacing: 12px;
                                    Muted { text: root.connection-setup; color: Theme.warning; horizontal-stretch: 1; }
                                    ActionButton { text: "Open Devices"; subtle: true; clicked => { root.navigate(2); } }
                                }
                            }
                        }
                        HorizontalLayout {
                            SectionTitle { text: root.saves-match ? "Progress on both PCs" : "This PC's progress"; horizontal-stretch: 1; }
                            if root.saves-match: StatusBadge { text: "Matching revision"; tint: Theme.success; }
                        }
                        Muted { text: root.save-state; }
                        if root.local-saves.length == 0: Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 8px;
                                Text { text: "Your next chapter starts here"; color: Theme.text; font-weight: 600; }
                                Muted { text: "No verified occupied save slots yet. Play and save, or receive your paired PC's progress. Save folders are detected automatically."; }
                            }
                        }
                        for save in (root.show-other-saves ? root.local-saves : root.local-saves.length > 0 ? [root.local-saves[0]] : []): SaveProgress {
                            title: save.title; kind: save.kind; date: save.date;
                            hearts: save.hearts; rupees: save.rupees; played: save.played;
                            extra: save.extra; warning: save.warning;
                        }
                        if root.local-saves.length > 1: ActionButton {
                            text: root.show-other-saves ? "Hide other save slots" : "Other save slots (" + (root.local-saves.length - 1) + ")";
                            subtle: true; clicked => { root.show-other-saves = !root.show-other-saves; }
                        }
                        if root.remote-saves.length > 0: SectionTitle { text: "Other PC · verified comparison"; }
                        for save in root.remote-saves: SaveProgress {
                            title: save.title; kind: save.kind; date: save.date;
                            hearts: save.hearts; rupees: save.rupees; played: save.played;
                            extra: save.extra; warning: save.warning;
                        }
                        ActionButton { text: root.show-verification ? "Hide snapshot verification" : "Snapshot verification"; subtle: true; clicked => { root.show-verification = !root.show-verification; } }
                        if root.show-verification: VerticalLayout {
                            spacing: 8px;
                            DetailBlock { title: "THIS PC · SHA-256"; text: root.local-revision == "" ? "No verified snapshot" : root.local-revision; }
                            DetailBlock { title: "OTHER PC · SHA-256"; text: root.remote-revision == "" ? "No verified snapshot" : root.remote-revision; }
                        }
                    }
                    if root.section == 1: VerticalLayout {
                        spacing: 20px;
                        PageHeading { title: "Game setup"; description: root.game-title + " · Install, update, or build your own copy."; }
                        if root.operation-busy || root.source-message != "" || root.source-error != "": Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 12px;
                                SectionTitle { text: root.sdk-busy ? "Installing build prerequisites" : root.operation-busy ? "Getting your adventure ready" : root.source-error == "" ? "Build status" : "Let's resolve this"; }
                                if root.operation-busy: ProgressIndicator {
                                    indeterminate: !root.source-busy || !root.source-progress-visible || !root.source-progress-known;
                                    progress: root.source-progress;
                                }
                                Text { text: root.source-message; color: Theme.text; wrap: char-wrap; min-width: 0px; }
                                if root.source-error != "": Text { text: root.source-error; color: Theme.danger; wrap: char-wrap; min-width: 0px; }
                                if root.source-building: Muted {
                                    text: "Build settings and game inputs are locked until this build finishes or is cancelled. You can still browse other pages.";
                                    color: Theme.accent;
                                }
                                if root.source-progress-visible: VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            Muted { text: root.source-busy ? "TOTAL ELAPSED" : "TOTAL TIME"; }
                                            Text { text: root.source-elapsed; color: Theme.text; font-size: 20px; wrap: char-wrap; min-width: 0px; }
                                        }
                                        if root.source-busy: VerticalLayout {
                                            horizontal-stretch: 1;
                                            Muted { text: "ESTIMATED STAGE LEFT"; }
                                            Text { text: root.source-eta; color: Theme.text; font-size: 20px; wrap: char-wrap; min-width: 0px; }
                                        }
                                    }
                                    if root.source-busy: Text { text: root.source-work; color: Theme.text; wrap: char-wrap; min-width: 0px; }
                                    if root.source-busy && root.source-rate != "": Muted { text: root.source-rate; }
                                    if root.source-busy: Muted { text: "Estimates cover this stage, not the whole build. Later stages may take additional time."; }
                                    if root.source-busy && root.source-activity-status != "": Muted { text: root.source-activity-status; }
                                }
                                Muted { text: root.sdk-busy ? "Complete any installer, license or Windows approval prompts. Keep the installer open until it finishes; SDK installation cannot be cancelled as a game build." : "Previous installations and saves stay intact until verification succeeds."; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    ActionButton { text: root.show-source-activity ? "Hide live activity" : "Show live activity"; clicked => { root.show-source-activity = !root.show-source-activity; } }
                                    if root.source-busy && !root.sdk-busy: ActionButton { text: "Cancel safely"; clicked => { root.action(Action.cancel-source, 0); } }
                                }
                                if root.show-source-activity: VerticalLayout {
                                    spacing: 10px;
                                    Muted { text: "LATEST ACTIVITY · NEWEST FIRST"; }
                                    activity-scroll := ScrollView {
                                        height: 170px;
                                        content-width: self.visible-width;
                                        VerticalLayout {
                                            alignment: start;
                                            padding-right: 16px;
                                            activity-text := Text {
                                                text: root.source-activity == "" ? "Live output will appear here as build tools report it. Vendor SDK installers may use their own windows." : root.source-activity;
                                                color: Theme.text; font-family: "Consolas"; font-size: 12px;
                                                wrap: char-wrap; min-width: 0px;
                                            }
                                        }
                                    }
                                    ActionButton { text: "Open full log externally"; available: root.source-log != ""; subtle: true; clicked => { root.action(Action.open-log, 0); } }
                                }
                                if root.has-built && !root.source-busy && root.source-activation-blocker != "": Muted { text: root.source-activation-blocker; }
                                if root.has-built: ActionButton { text: "Use completed build"; available: root.can-manage && root.source-activation-blocker == ""; clicked => { root.action(Action.use-built, 0); } }
                            }
                        }
                        if !root.preferences-valid: Surface {
                            VerticalLayout {
                                padding: 20px; spacing: 12px;
                                SectionTitle { text: "Build preferences need attention"; }
                                Muted { text: "Reset these preferences to choose your local inputs again. Games, saves, pairing and reservations are untouched."; }
                                ActionButton { text: "Reset build preferences"; available: !root.operation-busy; clicked => { root.action(Action.reset-source, 0); } }
                            }
                        }
                        Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 12px;
                                Text { text: "INSTALLATION METHOD"; color: Theme.muted; font-size: 11px; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    if root.selected-game != 2: ActionButton { text: "Official setup"; primary: !root.source-mode; available: root.can-manage; clicked => { root.toggle(Toggle.source-mode, false); } }
                                    ActionButton { text: "Build from source"; primary: root.source-mode; available: root.can-manage; clicked => { root.toggle(Toggle.source-mode, true); } }
                                    ActionButton { text: "Locate installed game"; available: root.can-locate; clicked => { root.action(Action.locate-game, 0); } }
                                }
                                Muted { text: root.installed-path == "" ? "New games are installed in your Games folder." : root.installed-path; }
                                if root.installed-executable != "": DetailBlock { title: "SELECTED EXECUTABLE"; text: root.installed-executable; }
                                if root.installed-release != "": Muted { text: "Installed release: " + root.installed-release; }
                                if root.selected-game == 1 && (!root.source-mode || root.setup-step == 2): SwitchRow {
                                    title: "NVIDIA DLSS / DLAA support";
                                    description: "Have TotK setup download NVIDIA's runtime (RTX GPUs only). Rendering modes stay in TotK's settings.";
                                    checked: root.nvidia; available: root.can-manage;
                                    toggled(value) => { root.toggle(Toggle.nvidia, value); }
                                }
                                if root.selected-game == 1 && (!root.source-mode || root.setup-step == 2): ActionButton {
                                    text: "Review NVIDIA SDK terms"; subtle: true;
                                    clicked => { root.action(Action.nvidia-terms, 0); }
                                }
                            }
                        }
                        if root.selected-game == 2: HorizontalLayout {
                            spacing: 10px;
                            ActionButton { text: "Triforce"; primary: !root.longshot; available: root.can-manage; clicked => { root.action(Action.select-oot-project, 0); } }
                            ActionButton { text: "Longshot"; primary: root.longshot; available: root.can-manage; clicked => { root.action(Action.select-oot-project, 1); } }
                        }
                        if root.source-mode: HorizontalLayout {
                            spacing: 10px;
                            ActionButton { text: "1  Tools"; primary: root.setup-step == 0; available: root.can-manage; clicked => { root.setup-step = 0; } }
                            if root.selected-game != 0: ActionButton { text: "2  Game files"; primary: root.setup-step == 1; available: root.can-manage; clicked => { root.setup-step = 1; } }
                            ActionButton { text: root.selected-game == 0 ? "2  Build" : "3  Build"; primary: root.setup-step == 2; available: root.can-manage; clicked => { root.setup-step = 2; } }
                        }
                        if root.source-mode && root.setup-step == 0: VerticalLayout {
                            spacing: 16px;
                            Muted { text: "Source builds take longer and are not confirmed safer. Scripts run with your permissions, outside a sandbox; use a separate VM for code you do not trust."; }
                            Surface {
                                VerticalLayout {
                                    padding: 22px; spacing: 14px;
                                    SectionTitle { text: "1   Get ready"; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        ActionButton { text: "Check source & tools"; available: root.can-manage; primary: root.source-tag == ""; clicked => { root.action(Action.check-source, 0); } }
                                        ActionButton { text: "Prepare build tools"; available: root.can-manage; clicked => { root.action(Action.prepare-tools, 0); } }
                                    }
                                    if root.source-tag != "": Muted { text: "Source " + root.source-tag + " · " + root.source-commit; }
                                    if root.source-tag != "": Muted { text: root.source-comparison; }
                                    if root.source-tag != "": ActionButton { text: "Review this source revision"; available: root.can-manage; clicked => { root.action(Action.review-source, 0); } }
                                    if root.can-compare-source: ActionButton { text: "Compare with installed source"; clicked => { root.action(Action.compare-source, 0); } }
                                    if root.tools.length > 0: HorizontalLayout {
                                        Text { text: root.tools-missing ? "Build prerequisites" : "All build prerequisites found"; color: root.tools-missing ? Theme.text : Theme.success; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; min-width: 0px; }
                                        ActionButton { text: root.show-tool-details ? "Hide checks" : "Show checks"; clicked => { root.show-tool-details = !root.show-tool-details; } }
                                    }
                                    if root.show-tool-details: VerticalLayout {
                                    spacing: 18px;
                                    for tool[index] in root.tools: BuildPrerequisite {
                                        tool: tool; available: root.can-manage;
                                        setup(kind) => { root.action(kind == 1 ? Action.setup-dotnet : kind == 2 ? Action.setup-msys : Action.setup-visual-studio, 0); }
                                        commands(kind) => { root.action(kind == 1 ? Action.copy-dotnet : kind == 2 ? Action.copy-msys : Action.copy-visual-studio, 0); }
                                        help => { root.action(Action.tool-help, index); }
                                    }
                                    }
                                    Muted { text: "After running copied commands, check source & tools again to refresh the results."; }
                                    ActionButton { text: root.selected-game == 0 ? "Next: review build" : "Next: game files"; primary: true; available: root.can-manage; clicked => { root.setup-step = root.selected-game == 0 ? 2 : 1; } }
                                }
                            }
                        }
                        if root.selected-game != 0 && (!root.source-mode || root.setup-step == 1): VerticalLayout {
                            spacing: 16px;
                            SectionTitle { text: root.source-mode ? "2   Your local game files" : "Your local game files"; }
                            Muted { text: "Choose your own legally obtained game files. They stay on this PC and are separate from texture packs."; }
                            GameFileInput {
                                title: root.selected-game == 1 ? "Tears of the Kingdom base game" : "Ocarina of Time game";
                                description: root.selected-game == 1 ? "Required: your base-game .nsp. Also accepts .xci, .nsz and .xcz. Choose the update separately below." : "Choose your own Ocarina of Time .nup game file. The selected PC project builds it locally from source.";
                                selected-path: root.source-input;
                                empty-text: root.selected-game == 2 && root.installed ? "No new input selected. Retained game files from the installed copy are reused when available." : "No game file selected";
                                choose-label: root.selected-game == 1 ? "Choose TotK base game (.nsp)" : "Choose OOT game (.nup)";
                                clear-label: "Clear game input";
                                available: root.can-manage;
                                choose => { root.choose-input(0); }
                                clear => { root.clear-input(0); }
                            }
                            if root.selected-game == 1: VerticalLayout {
                                spacing: 16px;
                                GameFileInput {
                                    title: "Tears of the Kingdom update";
                                    description: "Required: a supported game update in .nsp or .nsz format. This is separate from the base game.";
                                    selected-path: root.source-update;
                                    empty-text: "No update selected";
                                    choose-label: "Choose TotK update (.nsp)";
                                    clear-label: "Clear update";
                                    available: root.can-manage;
                                    choose => { root.choose-input(1); }
                                    clear => { root.clear-input(1); }
                                }
                                GameFileInput {
                                    title: "Console keys";
                                    description: "Required: your own prod.keys file. Keys are never supplied; sending them to your paired PC requires separate explicit approval.";
                                    selected-path: root.source-keys;
                                    empty-text: "No prod.keys file selected";
                                    choose-label: "Choose prod.keys";
                                    clear-label: "Clear keys selection";
                                    available: root.can-manage;
                                    choose => { root.choose-input(2); }
                                    clear => { root.clear-input(2); }
                                }
                            }
                            ActionButton {
                                text: root.extra-game-inputs ? "Hide additional input options" : root.selected-game == 1 ? "Optional firmware fonts" : "Use extracted OOT game files";
                                available: root.can-manage;
                                clicked => { root.extra-game-inputs = !root.extra-game-inputs; }
                            }
                            if root.selected-game == 1 && (root.extra-game-inputs || root.source-firmware != ""): GameFileInput {
                                title: "Firmware fonts (optional)";
                                description: "Choose a local firmware font folder only if needed. This is not the base game or update.";
                                selected-path: root.source-firmware;
                                empty-text: "No optional fonts selected";
                                choose-label: "Choose font folder";
                                clear-label: "Clear fonts";
                                available: root.can-manage;
                                choose => { root.choose-input(3); }
                                clear => { root.clear-input(3); }
                            }
                            if root.selected-game == 2 && root.extra-game-inputs: Surface {
                                VerticalLayout {
                                    padding: 20px; spacing: 12px;
                                    SectionTitle { text: "Extracted Ocarina of Time files"; }
                                    Muted { text: "Instead of a .nup, choose the parent folder containing romfs and exefs (or .triforce_exefs/.longshot_exefs in a previously built PC copy). Selecting it replaces the game input above."; }
                                    ActionButton { text: "Choose extracted OOT folder"; available: root.can-manage; clicked => { root.choose-input(4); } }
                                }
                            }
                            if root.source-mode: ActionButton { text: "Next: review build"; primary: true; available: root.can-manage; clicked => { root.setup-step = 2; } }
                        }
                        if root.source-mode && root.setup-step == 2: Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 14px;
                                SectionTitle { text: root.selected-game == 0 ? "2   Build your copy" : "3   Build your copy"; }
                                if root.source-tag != "": Muted { text: "Source " + root.source-tag + " · " + root.source-commit; }
                                if root.source-tag != "": Muted { text: root.source-comparison; }
                                if root.can-compare-source: ActionButton { text: "Compare with installed source"; clicked => { root.action(Action.compare-source, 0); } }
                                SwitchRow { title: "Prepare missing official build tools"; description: "Download verified tool archives after approval."; checked: root.managed-tools; available: root.can-manage; toggled(value) => { root.toggle(Toggle.managed-tools, value); } }
                                if root.selected-game == 2: ActionButton { text: root.advanced-source ? "Hide graphics options" : "Graphics options"; available: root.can-manage; clicked => { root.advanced-source = !root.advanced-source; } }
                                if root.selected-game == 2 && root.advanced-source: VerticalLayout {
                                    spacing: 6px;
                                    Muted { text: "Vulkan, SDL and movie/audio codecs are included. Codec binaries are supplied by Takoroka/ffmpeg-av1, not FFmpeg.org; checksums do not prove source-to-binary safety."; }
                                    if !root.longshot: SwitchRow { title: "RenoDX HDR"; description: "Upstream default; downloads shader/compiler dependencies."; checked: root.renodx; available: root.can-manage; toggled(value) => { root.toggle(Toggle.renodx, value); } }
                                    SwitchRow { title: "AMD FSR 4"; checked: root.fsr; available: root.can-manage; toggled(value) => { root.toggle(Toggle.fsr, value); } }
                                    SwitchRow { title: "NVIDIA DLSS / frame generation"; description: "Enable only after reviewing and accepting NVIDIA's SDK terms."; checked: root.nvidia; available: root.can-manage; toggled(value) => { root.toggle(Toggle.nvidia, value); } }
                                    ActionButton { text: "Review NVIDIA SDK terms"; clicked => { root.action(Action.nvidia-terms, 0); } }
                                    SwitchRow { title: "Prepare shaders after compiling"; description: "Recommended for smoother play. An empty or incompatible cache can take hours to prepare."; checked: root.shaders; available: root.can-manage; toggled(value) => { root.toggle(Toggle.shaders, value); } }
                                }
                                SwitchRow { title: "I reviewed the source and approve this build"; description: "I own the required game files and accept running this revision's scripts and dependencies."; checked: root.source-consent; available: root.can-manage && root.source-tag != ""; toggled(value) => { root.toggle(Toggle.source-consent, value); } }
                                if root.source-blocker != "": Muted { text: root.source-blocker; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    ActionButton { text: "Build & install"; primary: true; available: root.source-ready && !root.source-busy; clicked => { root.action(Action.build-source, 0); } }
                                }
                            }
                        }
                        if !root.source-mode: Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 12px;
                                SectionTitle { text: "Ready when you are"; }
                                Muted { text: root.release-tag == "" ? "Install the latest verified official release using your local game inputs." : "Latest official release: " + root.release-tag; }
                                if root.release-comparison != "": Muted { text: root.release-comparison; }
                                if root.release-detail != "": DetailBlock { title: "OFFICIAL DOWNLOAD VERIFICATION"; text: root.release-detail; }
                                if root.install-reason != "": Muted { text: root.install-reason; color: Theme.warning; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    ActionButton { text: "Install / update"; primary: true; available: root.can-install; clicked => { root.action(Action.install-release, 0); } }
                                    ActionButton { text: "Check latest"; available: root.can-manage; clicked => { root.action(Action.check-release, 0); } }
                                }
                                Muted { text: root.selected-game == 0 ? "Installs in Games/Dusklight and retains previous managed folders for recovery. Your profile, saves and textures are preserved. Open games through the single Twilight Sync desktop shortcut and Play." : "The official setup runs inside this managed workflow. Inputs stay on your PCs unless you explicitly approve paired transfer; saves, settings and mods are preserved."; }
                                if root.selected-game == 1: ActionButton { text: "Optional manual setup download"; subtle: true; clicked => { root.action(Action.official-help, 0); } }
                            }
                        }
                        if root.selected-game != 0: Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 12px;
                                SectionTitle { text: "Transfer inputs to your paired PC"; }
                                Muted { text: "All transfer permissions and manual file offers live in Settings > Game-file transfers. Your selected build inputs are reused there."; }
                                ActionButton {
                                    text: "Open game-file transfers";
                                    clicked => { root.navigate(5); }
                                }
                            }
                        }
                    }
                    if root.section == 2: VerticalLayout {
                        spacing: 20px;
                        PageHeading { title: "Your devices"; description: "A private connection between your PCs. No cloud account or relay."; }
                        if root.pairing-code == "": Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 12px;
                                SectionTitle { text: "1   Your private network"; }
                                Text { text: root.network-name; color: Theme.text; }
                                Muted { text: root.network-detail; }
                                ActionButton { text: root.network-trusted ? "Network approved" : "Approve this network"; primary: !root.network-trusted; available: !root.network-trusted && root.network-available && root.management-available; clicked => { root.action(Action.trust-network, 0); } }
                                ActionButton { text: root.show-network-details ? "Hide network fingerprint" : "Network fingerprint"; subtle: true; clicked => { root.show-network-details = !root.show-network-details; } }
                                if root.show-network-details: VerticalLayout {
                                    spacing: 8px;
                                    DetailBlock { title: "APPROVED ROUTER / SUBNET BINDING"; text: root.network-fingerprint; }
                                    Muted { text: "A router fingerprint is a spoofable network policy check, not device authentication. Pairing and pinned keys provide a separate layer."; }
                                }
                            }
                        }
                        if root.pairing-code == "": Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 12px;
                                SectionTitle { text: root.peer-key == "" ? "2   Find your other PC" : "Your paired device"; }
                                Muted { text: root.peer-key == "" ? "Open the two-minute pairing window on both PCs. Choose Compare codes on just one screen. Discovery names are not verified identities." : "Paired with " + root.peer-name; }
                                if root.peer-key != "": StatusBadge { text: root.connected ? "Connected · pinned identity verified" : root.connecting ? "Reconnecting…" : "Offline · device trust retained"; tint: root.connected ? Theme.success : Theme.muted; }
                                if root.peer-key != "" && !root.connected: ActionButton { text: root.connecting ? "Reconnecting…" : "Reconnect"; available: root.can-reconnect; clicked => { root.action(Action.reconnect, 0); } }
                                if root.peer-key == "": ActionButton { text: root.pairing-open ? "Restart pairing window" : "Open pairing"; available: root.can-pair; clicked => { root.action(Action.open-pairing, 0); } }
                                if root.peer-key == "" && root.devices.length == 0: Muted { text: "No nearby devices yet. Open Twilight Sync on the other PC and approve the same router. Private-network firewall rules or guest Wi-Fi isolation may block discovery."; }
                                if root.connecting: ProgressIndicator { indeterminate: true; }
                                if root.peer-key == "": VerticalLayout {
                                for device[index] in root.devices: HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout { horizontal-stretch: 1; Text { text: device.name; color: Theme.text; wrap: word-wrap; } Muted { text: device.detail; } }
                                    ActionButton { text: "Compare codes"; available: device.pairing; clicked => { root.action(Action.connect-device, index); } }
                                }
                                }
                                if root.peer-key != "": ActionButton { text: root.show-peer-identity ? "Hide verified device identity" : "Verified device identity"; subtle: true; clicked => { root.show-peer-identity = !root.show-peer-identity; } }
                                if root.peer-key != "" && root.show-peer-identity: DetailBlock { title: "PINNED DEVICE PUBLIC KEY"; text: root.peer-key; }
                            }
                        }
                        if root.pairing-code != "": Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 16px;
                                SectionTitle { text: "3   Compare the full code on both PCs"; }
                                Text { text: root.pairing-code; color: Theme.accent; font-size: 28px; font-weight: 600; wrap: word-wrap; }
                                Muted { text: "Approve only if every part matches. Both PCs must confirm."; }
                                Muted { text: "The code belongs to this handshake, not a reusable password. Reject the request if any digit differs."; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    StatusBadge { text: root.pairing-approved ? "This PC · approved" : "This PC · waiting"; tint: root.pairing-approved ? Theme.success : Theme.muted; }
                                    StatusBadge { text: root.remote-approved ? "Other PC · approved" : "Other PC · waiting"; tint: root.remote-approved ? Theme.success : Theme.muted; }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    ActionButton { text: root.pairing-approved ? "Approved · waiting" : "Codes match"; primary: true; available: !root.pairing-approved; clicked => { root.action(Action.approve-pairing, 0); } }
                                    ActionButton { text: "Cancel pairing"; clicked => { root.action(Action.reject-pairing, 0); } }
                                }
                            }
                        }
                        if root.peer-key != "": ActionButton { text: "Unpair this device"; available: root.management-available; clicked => { root.action(Action.unpair, 0); } }
                    }
                    if root.section == 3: VerticalLayout {
                        spacing: 20px;
                        PageHeading { title: "Save history"; description: root.game-title + " · Complete branches, with a way back."; }
                        HorizontalLayout {
                            spacing: 10px;
                            ActionButton { text: "Refresh history"; clicked => { root.action(Action.history-refresh, 0); } }
                            ActionButton { text: "Older snapshots"; available: root.history-more; clicked => { root.action(Action.history-older, 0); } }
                        }
                        Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 12px;
                                SectionTitle { text: "Snapshot storage"; }
                                Muted { text: root.history-info; }
                                Rectangle {
                                    height: 6px; border-radius: 3px; background: Theme.raised;
                                    Rectangle { width: parent.width * root.history-usage; border-radius: 3px; background: Theme.accent-fill; }
                                }
                                Muted { text: "Unchanged blocks are shared. Oldest snapshots are pruned at the managed budget; filesystem overhead is separate."; }
                                ActionButton { text: root.show-history-storage ? "Hide storage details" : "How snapshots work"; subtle: true; clicked => { root.show-history-storage = !root.show-history-storage; } }
                                if root.show-history-storage: Muted { text: root.history-storage + "\nValid stable saves are captured automatically, including autosaves. Restore creates a new commit and retains normal sync conflict checks. A corrupt current file must be moved aside first."; }
                            }
                        }
                        if root.history.length == 0: Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 8px;
                                SectionTitle { text: "No snapshots yet"; }
                                Muted { text: "Play and save, or receive your paired PC's progress. Verified saves are recorded automatically for this game."; }
                            }
                        }
                        for item[index] in root.history: history-card := Surface {
                            property <bool> expanded: false;
                            VerticalLayout {
                                padding: 20px; spacing: 12px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    Rectangle { width: 10px; height: 10px; border-radius: 5px; background: item.branch == 1 ? Theme.warning : item.branch == 2 ? Theme.success : Theme.accent; }
                                    Text { text: item.title + (item.current ? " · CURRENT" : ""); color: item.current ? Theme.accent : Theme.text; font-weight: 600; wrap: word-wrap; }
                                }
                                Muted { text: item.detail; }
                                Muted { text: item.ancestry; font-size: 12px; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    ActionButton { text: "View progress"; clicked => { root.action(Action.history-preview, index); } }
                                    ActionButton { text: "Restore"; available: !item.current && root.can-restore; clicked => { root.action(Action.history-restore, index); } }
                                }
                                ActionButton { text: history-card.expanded ? "Hide snapshot details" : "Snapshot details"; subtle: true; clicked => { history-card.expanded = !history-card.expanded; } }
                                if history-card.expanded: DetailBlock { title: "SNAPSHOT / BRANCH DETAILS"; text: item.metadata; }
                                if root.preview-title != "" && root.preview-id == item.id: VerticalLayout {
                                    spacing: 12px;
                                    SectionTitle { text: root.preview-title; }
                                    Muted { text: "Read-only preview. Nothing is restored until you approve a Restore action."; }
                                    for save in root.preview-saves: SaveProgress {
                                        title: save.title; kind: save.kind; date: save.date;
                                        hearts: save.hearts; rupees: save.rupees; played: save.played;
                                        extra: save.extra; warning: save.warning; expanded: true;
                                    }
                                    if root.preview-saves.length == 0: Muted { text: "No occupied save slots in this verified snapshot."; }
                                    ActionButton { text: "Close preview"; clicked => { root.action(Action.close-preview, 0); } }
                                }
                            }
                        }
                    }
                    if root.section == 4: VerticalLayout {
                        spacing: 20px;
                        PageHeading { title: "Dusklight texture packs"; description: "Install a complete pack, switch versions, or restore your original textures. These packs are for Twilight Princess only."; }
                        if root.selected-game != 0: Muted { text: "This library always manages Dusklight textures, not " + root.game-title + "."; }
                        if root.texture-status != "" || root.texture-busy: Surface {
                            VerticalLayout {
                                padding: 20px; spacing: 12px;
                                Muted { text: root.texture-status; }
                                if root.texture-busy: ProgressIndicator { indeterminate: true; }
                                if root.texture-busy && root.texture-cancellable: ActionButton { text: "Cancel installation safely"; clicked => { root.action(Action.cancel-textures, 0); } }
                            }
                        }
                        Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 12px;
                                SectionTitle { text: "Installed packs"; }
                                Muted { text: "One pack is active at a time. Changes apply on your next Dusklight launch."; }
                                if root.textures-unmanaged: VerticalLayout {
                                    spacing: 10px;
                                    StatusBadge { text: "Existing textures detected"; tint: Theme.warning; }
                                    Muted { text: "Texture files are already in your Dusklight profile, but were installed outside this library. They have not been removed. Choose their creator and confirm permission below, then add them to the library to track and switch versions. The existing files are backed up unchanged."; }
                                }
                                if root.packs.length == 0 && !root.textures-unmanaged: Muted { text: "No packs installed yet. Choose a pack and install its ZIP or folder below."; }
                                for pack[index] in root.packs: pack-card := Surface {
                                    property <bool> expanded: false;
                                    VerticalLayout {
                                        padding: 16px; spacing: 10px;
                                        Text { text: pack.title; color: Theme.text; font-weight: 600; wrap: word-wrap; }
                                        if pack.active: StatusBadge { text: "Active"; tint: Theme.success; }
                                        Muted { text: pack.detail; }
                                        if !pack.active: ActionButton { text: "Activate"; available: root.can-change-textures; clicked => { root.action(Action.activate-texture, index); } }
                                        ActionButton { text: pack-card.expanded ? "Hide version details" : "Version details"; subtle: true; clicked => { pack-card.expanded = !pack-card.expanded; } }
                                        if pack-card.expanded: DetailBlock { title: "VERSION / CONTENT ID"; text: pack.metadata; }
                                    }
                                }
                                ActionButton { text: "Disable pack and restore original textures"; available: root.can-change-textures && root.textures-active; clicked => { root.action(Action.disable-textures, 0); } }
                                if root.texture-reason != "": Muted { text: root.texture-reason; color: Theme.warning; }
                                if root.texture-recovery: ActionButton { text: "Recover interrupted texture switch"; available: root.management-available; clicked => { root.action(Action.recover-textures, 0); } }
                            }
                        }
                        Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 12px;
                                SectionTitle { text: "Install or update a pack"; }
                                Muted { text: "1. Choose the pack you downloaded. Get the complete ZIP from its creator, or use an extracted folder. No manual extraction or config selection is needed."; }
                                ActionButton {
                                    text: root.texture-creators.length == 0 ? "No texture presets available" : root.texture-creators[root.texture-creator].name + (root.texture-picker-open ? " · Hide choices" : " · Change");
                                    available: !root.texture-busy && root.texture-creators.length > 0;
                                    clicked => { root.texture-picker-open = !root.texture-picker-open; }
                                }
                                if root.texture-picker-open: VerticalLayout {
                                    spacing: 8px;
                                    for creator[index] in root.texture-creators: ActionButton {
                                        text: creator.name; primary: root.texture-creator == index;
                                        available: !root.texture-busy;
                                        clicked => { root.texture-creator = index; root.texture-picker-open = false; }
                                    }
                                }
                                if root.texture-creators.length > 0: Muted { text: root.texture-creators[root.texture-creator].description; }
                                if root.texture-creators.length > 0 && root.texture-creators[root.texture-creator].has-site: ActionButton { text: "Visit creator download page"; clicked => { root.action(Action.open-texture-site, root.texture-creator); } }
                                Muted { text: "2. Confirm permission, then choose your downloaded ZIP or folder. Installing also activates the pack; older versions stay in your library."; }
                                SwitchRow { title: "I have permission to use these textures"; checked: root.texture-consent; toggled(value) => { root.toggle(Toggle.texture-consent, value); } }
                                ActionButton { text: root.texture-details-open ? "Hide version label" : "Edit version label"; subtle: true; available: !root.texture-busy; clicked => { root.texture-details-open = !root.texture-details-open; } }
                                if root.texture-details-open: VerticalLayout {
                                    spacing: 8px;
                                    Muted { text: "A label for your library, not a verified release version. A default is filled in for you."; }
                                    LineEdit { text <=> root.texture-version; placeholder-text: "Version label"; enabled: !root.texture-busy && !Theme.modal-open; }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    ActionButton { text: "Install ZIP"; primary: true; available: root.texture-consent && root.can-import-textures; clicked => { root.action(Action.import-texture-zip, 0); } }
                                    ActionButton { text: "Install folder"; available: root.texture-consent && root.can-import-textures; clicked => { root.action(Action.import-texture-folder, 0); } }
                                }
                                if root.textures-unmanaged: ActionButton { text: "Add existing textures to library"; available: root.texture-consent && root.can-import-textures; clicked => { root.action(Action.import-existing-textures, 0); } }
                                Muted { text: "Twilight Sync does not download packs for you or share them with your paired PC. Only validated texture images are installed; creator access restrictions are never bypassed."; }
                            }
                        }
                        Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 12px;
                                SectionTitle { text: "Dusklight profile"; }
                                Muted { text: root.texture-profile == "" ? "Locate or install Dusklight in Game setup. Its profile is detected automatically." : "Packs are applied to the profile Dusklight actually uses. Your saves are not changed."; }
                                if root.texture-profile != "": ActionButton { text: root.texture-profile-open ? "Hide profile details" : "Profile details"; subtle: true; clicked => { root.texture-profile-open = !root.texture-profile-open; } }
                                if root.texture-profile-open && root.texture-profile != "": DetailBlock { title: "DETECTED PROFILE"; text: root.texture-profile; }
                                ActionButton { text: "Refresh library"; available: root.management-available; clicked => { root.action(Action.refresh-textures, 0); } }
                            }
                        }
                    }
                    if root.section == 5: VerticalLayout {
                        spacing: 20px;
                        PageHeading { title: "Settings & security"; description: "Your appearance, your privacy, your rules."; }
                        Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 12px;
                                SectionTitle { text: "Desktop shortcut"; }
                                Muted { text: "One Twilight Sync icon for your whole library. It opens the app, not a game. Missing shortcuts are restored when the app starts after an update; separate game icons are no longer created."; }
                                ActionButton {
                                    text: root.desktop-shortcut-busy ? "Repairing desktop shortcut…" : "Create / repair desktop shortcut";
                                    available: !root.desktop-shortcut-busy && !root.demo-mode;
                                    clicked => { root.action(Action.create-desktop-shortcut, 0); }
                                }
                            }
                        }
                        Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 14px;
                                SectionTitle { text: "Appearance"; }
                                Muted { text: "Soft glass surfaces, in light or dark. System follows your Windows app setting."; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    ActionButton { text: "System"; primary: root.appearance-mode == AppearanceMode.system; clicked => { root.appearance-selected(AppearanceMode.system); } }
                                    ActionButton { text: "Light"; primary: root.appearance-mode == AppearanceMode.light; clicked => { root.appearance-selected(AppearanceMode.light); } }
                                    ActionButton { text: "Dark"; primary: root.appearance-mode == AppearanceMode.dark; clicked => { root.appearance-selected(AppearanceMode.dark); } }
                                }
                            }
                        }
                        Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 14px;
                                SectionTitle { text: "Startup & background"; }
                                SwitchRow { title: "Ready when Windows starts"; description: "Start quietly in the tray."; checked: root.startup; toggled(value) => { root.toggle(Toggle.startup, value); } }
                                SwitchRow { title: "Automatically check for app updates"; description: "Checks when you open Twilight Sync. Installing still needs your approval."; checked: root.auto-updates; toggled(value) => { root.toggle(Toggle.updates, value); } }
                                Muted { text: "Closing the window keeps sync running in the tray. Double-click the moon icon to reopen it, or use Quit to exit."; }
                            }
                        }
                        Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 12px;
                                SectionTitle { text: "Keep the good things coming"; }
                                Muted { text: "Installed version: " + root.version; }
                                Muted { text: root.app-update; }
                                if root.app-release-detail != "": DetailBlock { title: "APP RELEASE / VERIFICATION"; text: root.app-release-detail; }
                                if root.app-update-reason != "": Muted { text: root.app-update-reason; color: Theme.warning; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    ActionButton { text: "Check for updates"; available: root.can-check-app; clicked => { root.action(Action.check-app-update, 0); } }
                                    ActionButton { text: "Update Twilight Sync"; available: root.can-update-app; primary: root.can-update-app; clicked => { root.action(Action.update-app, 0); } }
                                }
                                if root.has-app-release: ActionButton { text: "Release notes"; subtle: true; clicked => { root.action(Action.app-release-notes, 0); } }
                                Muted { text: "Downloads are checked against the release's SHA-256. The app is currently unsigned: integrity is not publisher trust."; }
                            }
                        }
                        Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 12px;
                                SectionTitle { text: "Game-file transfers"; }
                                Muted { text: "Choose a game to offer its local files to your paired PC. Each game has separate permissions; console keys have their own opt-in."; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    ActionButton { text: "Dusklight"; primary: root.selected-game == 0; clicked => { root.selected-game = 0; root.game-selected(0); } }
                                    ActionButton { text: "TotK"; primary: root.selected-game == 1; clicked => { root.selected-game = 1; root.game-selected(1); } }
                                    ActionButton { text: "OOT"; primary: root.selected-game == 2; clicked => { root.selected-game = 2; root.game-selected(2); } }
                                }
                                if root.selected-game == 0: VerticalLayout {
                                    spacing: 12px;
                                    Muted { text: "Only your verified Twilight Princess GameCube ISO/RVZ. Disabled by default. Never downloads games."; }
                                    SwitchRow { title: "I own this game and allow disc transfers"; checked: root.disc-sharing; toggled(value) => { root.toggle(Toggle.disc-sharing, value); } }
                                    Muted { text: root.iso-path; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        ActionButton { text: "Choose ISO / RVZ"; clicked => { root.action(Action.choose-iso, 0); } }
                                        ActionButton { text: "Offer verified disc"; available: root.can-send-iso; clicked => { root.action(Action.send-iso, 0); } }
                                    }
                                }
                                if root.selected-game != 0: GameInputTransfers {
                                    game: root.selected-game; sharing: root.game-file-sharing; key-sharing: root.key-sharing;
                                    can-choose: root.can-manage; can-offer: root.can-offer-game-file; can-offer-update: root.can-offer-update; can-offer-keys: root.can-offer-keys;
                                    input: root.source-input; update: root.source-update; keys: root.source-keys; reason: root.game-file-transfer-reason;
                                    choose(kind) => { root.choose-input(kind); }
                                    offer(kind) => { root.action(Action.offer-game-file, kind); }
                                    sharing-toggled(value) => { root.toggle(Toggle.game-file-sharing, value); }
                                    keys-toggled(value) => { root.toggle(Toggle.key-sharing, value); }
                                }
                            }
                        }
                        Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 14px;
                                SectionTitle { text: "Private by design"; }
                                Muted { text: "Saves travel directly between your paired PCs, not through a cloud relay. Public discovery names are unverified hints; the full pinned device key is checked on reconnect."; }
                                DetailBlock { title: "THIS DEVICE · PUBLIC IDENTITY"; text: root.public-key; }
                                Muted { text: "The private identity key is protected by Windows DPAPI for your user account. Save snapshots are not encrypted at rest. Local logs contain usernames, paths, hashes, peer identities and security decisions—keep them private."; }
                                ActionButton { text: "Open local data"; clicked => { root.action(Action.open-data, 0); } }
                            }
                        }
                        Surface {
                            VerticalLayout {
                                padding: 22px; spacing: 14px;
                                SectionTitle { text: "How the secure channel works"; }
                                StatusBadge { text: "twilightProto/1 · Noise XX"; tint: Theme.success; }
                                Text { text: "Encrypted, authenticated, identity-pinned"; color: Theme.text; font-weight: 600; wrap: word-wrap; }
                                Muted { text: "X25519 key agreement, ChaCha20-Poly1305 authenticated encryption and SHA-256. Each direction rekeys after 4,096 authenticated events. Pairing requires both PCs to compare the entire session-specific code and approve."; }
                                Text { text: "Your network is an explicit boundary"; color: Theme.text; font-weight: 600; wrap: word-wrap; }
                                Muted { text: "A private physical IPv4 interface, direct subnet and approved router fingerprint gate LAN activity. Router changes or stale verification close the channel. Router identities can be spoofed; they do not replace pairing."; }
                                Text { text: "Validated data, not remote execution"; color: Theme.text; font-weight: 600; wrap: word-wrap; }
                                Muted { text: "Bounded, game-scoped save events are checked before replacement. Games have separate histories, common bases and play reservations. Game inputs and console keys require separate explicit transfer approval. No peer shell commands, executable attachments or arbitrary directories."; }
                                Text { text: "Protection without false promises"; color: Theme.text; font-weight: 600; wrap: word-wrap; }
                                Muted { text: "Different progress requires a branch choice; prior saves are retained. Play reservations survive disconnects and restarts. Direct game launches can bypass cooperative protection. Save validation is not proof against every game exploit. This early release has not had an independent security audit; a compromised PC remains outside the trust boundary."; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            ActionButton { text: "Licenses & credits"; clicked => { root.about-open = true; } }
                            ActionButton { text: "Quit"; clicked => { root.action(Action.quit, 0); } }
                        }
                    }
                    Rectangle { height: 16px; background: transparent; }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }
        Rectangle {
            height: 36px; background: Theme.chrome;
            HorizontalLayout {
                padding-left: 24px; padding-right: 24px;
                Text { text: root.status; color: Theme.muted; font-size: 11px; overflow: elide; vertical-alignment: center; }
                Text { text: "Local first. Private by design."; color: Theme.muted; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
            }
        }
    }
    if root.comparison-open: FocusScope {
        init => { self.focus(); }
        Rectangle {
            background: #0008;
            TouchArea { scroll-event(event) => { accept } }
            Surface {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: min(parent.width - 40px, 1040px); height: parent.height - 48px;
                background: Theme.dialog;
                VerticalLayout {
                    padding: 24px; spacing: 16px;
                    PageHeading { title: "Compare complete saves"; description: root.game-title + " · No default winner. Both original branches are retained."; }
                    if root.base-revision != "": DetailBlock { title: "LAST COMMON SAVE → THIS PC / OTHER PC"; text: root.base-revision; }
                    if root.base-revision == "": Muted { text: "No verified common save. Compare both complete branches before choosing."; }
                    ScrollView {
                        horizontal-stretch: 1; vertical-stretch: 1;
                        HorizontalLayout {
                            spacing: 14px; alignment: start;
                            BranchPreview {
                                horizontal-stretch: 1;
                                title: "This PC"; revision: root.local-revision; changes: root.local-changes;
                                saves: root.local-saves; selectable: root.can-resolve; selected: root.branch-choice == 0;
                                choose => { root.branch-choice = 0; }
                            }
                            BranchPreview {
                                horizontal-stretch: 1;
                                title: root.peer-name == "" ? "Other PC" : "Other PC · " + root.peer-name; remote: true; revision: root.remote-revision; changes: root.remote-changes;
                                saves: root.remote-saves; selectable: root.can-resolve; selected: root.branch-choice == 1;
                                choose => { root.branch-choice = 1; }
                            }
                        }
                    }
                    Muted { text: "A choice applies to every save slot, not just the visible one. Your other PC must still approve replacement of different progress."; }
                    if root.comparison-reason != "": Muted { text: root.comparison-reason; color: Theme.warning; }
                    HorizontalLayout {
                        spacing: 10px;
                        ActionButton {
                            text: root.branch-choice == 0 ? "Use this PC's save" : root.branch-choice == 1 ? "Use other PC's save" : "Choose a branch above";
                            primary: true; available: root.branch-choice >= 0 && root.can-resolve; modal-control: true;
                            clicked => { root.action(root.branch-choice == 0 ? Action.use-local : Action.use-remote, 0); }
                        }
                        ActionButton { text: "Keep both, play here"; available: root.can-continue; modal-control: true; clicked => { root.action(Action.continue-local, 0); } }
                        ActionButton { text: "Not now"; modal-control: true; clicked => { root.comparison-open = false; } }
                    }
                }
            }
        }
        key-pressed(event) => {
            if event.text == Key.Escape { root.comparison-open = false; return accept; }
            return reject;
        }
    }
    if root.about-open: FocusScope {
        init => { self.focus(); }
        Rectangle {
            background: #000a;
            TouchArea { scroll-event(event) => { accept } }
            about-dialog := Rectangle {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: min(parent.width - 40px, 480px); height: min(parent.height - 40px, root.demo-mode ? 560px : 320px);
                background: Theme.dialog; border-radius: 18px; border-width: 1px; border-color: Theme.line;
                VerticalLayout {
                    padding: 20px; spacing: 12px;
                    HorizontalLayout {
                        spacing: 12px;
                        Image { source: @image-url("../assets/app-icon-256.png"); width: 44px; height: 44px; }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            alignment: center;
                            Text { text: "Twilight Sync"; font-size: 20px; font-weight: 700; color: Theme.text; }
                            Muted { text: "Version " + root.version; font-size: 12px; }
                        }
                        CompactActionButton { text: "Done"; subtle: true; modal-control: true; clicked => { root.about-open = false; } }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 10px; alignment: start;
                            SectionTitle { text: "Your adventures, across your PCs."; font-size: 16px; min-height: 22px; }
                            Muted { text: "A local-first game library with encrypted save sharing. Built by @false00. Not affiliated with Nintendo."; font-size: 13px; }
                            HorizontalLayout {
                                spacing: 6px; alignment: start;
                                CompactActionButton { text: "Developer"; modal-control: true; clicked => { root.action(Action.project-link, 0); } }
                                CompactActionButton { text: "Source code"; modal-control: true; clicked => { root.action(Action.project-link, 1); } }
                                CompactActionButton { text: "Releases"; modal-control: true; clicked => { root.action(Action.project-link, 2); } }
                            }
                            Rectangle { height: 1px; background: Theme.line; }
                            Muted { text: root.build-profile + " build · " + root.build-target + " · MIT license"; font-size: 12px; }
                            HorizontalLayout {
                                alignment: start;
                                CompactActionButton { text: "View third-party licenses"; modal-control: true; clicked => { root.action(Action.open-licenses, 0); } }
                            }
                            if root.demo-mode: VerticalLayout {
                                spacing: 6px; alignment: start;
                                Muted { text: "Synthetic preview scenarios. No real saves, pairing or settings are changed."; }
                                for scenario[index] in ["Synchronized saves", "Divergent saves", "Pairing", "Offline", "Connecting"]: CompactActionButton {
                                    text: "Preview: " + scenario;
                                    modal-control: true;
                                    clicked => { root.action(Action.preview-scenario, index); }
                                }
                                CompactActionButton { text: "Save example screenshot"; modal-control: true; clicked => { root.action(Action.export-preview, 0); } }
                            }
                        }
                    }
                }
            }
        }
        key-pressed(event) => {
            if event.text == Key.Escape { root.about-open = false; return accept; }
            return reject;
        }
    }
    if root.confirmation-open: FocusScope {
        init => { self.focus(); }
        Rectangle {
            background: Theme.dark ? #0009 : #0006;
            TouchArea { scroll-event(event) => { accept } }
            Rectangle {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: min(parent.width - 48px, 570px); height: min(parent.height - 48px, 390px);
                background: Theme.dialog; border-radius: 22px; border-width: 1px; border-color: Theme.line;
                VerticalLayout {
                    padding: 24px; spacing: 14px;
                    SectionTitle { text: root.confirmation-title; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            Text { text: root.confirmation-message; wrap: word-wrap; color: Theme.text; font-size: 14px; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        ActionButton { text: "Cancel"; modal-control: true; clicked => { root.confirmation-response(false); } }
                        ActionButton { text: "Continue"; primary: true; modal-control: true; clicked => { root.confirmation-response(true); } }
                    }
                }
            }
        }
        key-pressed(event) => {
            if event.text == Key.Escape { root.confirmation-response(false); return accept; }
            return reject;
        }
    }
}
